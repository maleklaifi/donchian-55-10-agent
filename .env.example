MODE=paper
INITIAL_CAPITAL=200
DATA_DIR=/data
BINANCE_BASE_URL=https://data-api.binance.vision
# Set a long unique password in Railway. Dashboard username: admin.
DASHBOARD_TOKEN=replace-with-a-long-unique-password
# Optional exchange execution (default remains paper).
# Set MODE=testnet with Spot Testnet keys, or MODE=live with production keys.
# Set LIVE_TRADING_ACK only when you intentionally enable real-money orders.
LIVE_TRADING_ACK=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Stop NEW entries while continuing exits and reconciliation:
PAUSE_ENTRIES=false

# Manual strategy settings; redeploy after edits. Defaults reproduce supplied rules.
ENTRY_DAYS=55
EXIT_DAYS=10
ATR_DAYS=20
ATR_MULTIPLIER=2
RISK_PERCENT=0.5
PORTFOLIO_RISK_PERCENT=2
MAX_POSITIONS=5
MAX_POSITION_USDT=100
MIN_POSITION_USDT=10
MAX_POSITION_EQUITY_PERCENT=50
